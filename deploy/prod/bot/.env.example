# Версия образов Sylph (тег из GHCR, всегда конкретный: не edge)
SYLPH_VERSION=0.1.0

# Токен бота от @BotFather
SYLPH_BOT_TOKEN=

# Домен вебхука ЮKassa: DNS смотрит прямо на эту машину.
# В кабинете ЮKassa URL уведомлений: https://<этот домен>/yookassa
SYLPH_BOT_DOMAIN=pay.example.com

# Адрес subs: ссылка юзера — <адрес>/<токен>
SYLPH_SUBS_URL=https://sub.example.com

# Ядро: IP или домен машины A, порт 443. Имя в серте ядра — SYLPH_CORE_NAME
SYLPH_CORE_URL=https://203.0.113.10:443
SYLPH_CORE_NAME=core.sylph.internal

# Иконки из пака tgiosicons: нужен Telegram Premium у владельца бота
SYLPH_BOT_CUSTOM_EMOJI=false
SYLPH_BOT_TZ=Europe/Moscow

# Сеть compose и адрес Caddy в ней: бот верит X-Forwarded-For только от этого адреса.
# Менять, только если подсеть пересекается с сетями машины (адрес Caddy — внутри подсети).
SYLPH_SUBNET=172.30.11.0/24
SYLPH_CADDY_IP=172.30.11.10
SYLPH_HTTPS_PORT=443
SYLPH_LOG_LEVEL=info
