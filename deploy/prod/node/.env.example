# Версия образов Sylph (тег из GHCR, всегда конкретный: не edge)
SYLPH_VERSION=0.1.0
# Версия xray-core: агент пишет конфиг под неё и отдаёт её в heartbeat
XRAY_VERSION=26.10.21

# Ядро: IP или домен машины A, порт 443. Имя в серте ядра — SYLPH_CORE_NAME
SYLPH_CORE_URL=https://203.0.113.10:443
SYLPH_CORE_NAME=core.sylph.internal

# Внешний порт ноды (Caddy layer4 перед xray)
SYLPH_HTTPS_PORT=443
SYLPH_LOG_LEVEL=info

# Доп. IP сервера для выделенных адресов юзеров, через запятую. Меняется командой
# sudo ./sylph ip add/remove — она же пишет compose.egress.yml с их сетями и COMPOSE_FILE
SYLPH_EGRESS_IPS=
