# Версия образов Sylph (тег из GHCR, всегда конкретный: не edge)
SYLPH_VERSION=0.1.0

# Домен subs: DNS смотрит прямо на эту машину. Тот же адрес — в SYLPH_SUBS_URL бота
SYLPH_SUBS_DOMAIN=sub.example.com

# Ядро: IP или домен машины A, порт 443. Имя в серте ядра — SYLPH_CORE_NAME
SYLPH_CORE_URL=https://203.0.113.10:443
SYLPH_CORE_NAME=core.sylph.internal

# Как часто клиенту обновлять подписку, часов (1–168)
SYLPH_SUBS_UPDATE_HOURS=12
# Пояс «оплачено до» на страничке подписки
SYLPH_SUBS_TZ=Europe/Moscow

# Сеть compose и адрес Caddy в ней.
# Менять, только если подсеть пересекается с сетями машины (адрес Caddy — внутри подсети).
SYLPH_SUBNET=172.30.12.0/24
SYLPH_CADDY_IP=172.30.12.10
SYLPH_HTTPS_PORT=443
SYLPH_LOG_LEVEL=info
