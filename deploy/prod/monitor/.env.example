# Версия образов Sylph (тег из GHCR, всегда конкретный: не edge)
SYLPH_VERSION=0.1.0

# Ядро: IP или домен машины A, порт 443. Имя в серте ядра — SYLPH_CORE_NAME
SYLPH_CORE_URL=https://203.0.113.10:443
SYLPH_CORE_NAME=core.sylph.internal

# Бот алертов: отдельный бот от @BotFather, не клиентский
SYLPH_MONITOR_BOT_TOKEN=
# Кому слать алерты: Telegram ID через запятую. Каждый должен один раз написать боту /start
SYLPH_MONITOR_CHAT_IDS=

# Необязательно: адрес панели — в алертах появятся ссылки на ноду или платежи
SYLPH_MONITOR_PANEL_URL=https://panel.example.com
# Пояс времени в сообщениях
SYLPH_MONITOR_TZ=Europe/Moscow
SYLPH_LOG_LEVEL=info
