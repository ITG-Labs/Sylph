# Версия образов Sylph (тег из GHCR, всегда конкретный: не edge)
SYLPH_VERSION=0.1.0

# Домен панели: DNS смотрит прямо на эту машину, серт Let's Encrypt выпустит Caddy
SYLPH_PANEL_DOMAIN=panel.example.com

# Ядро: IP или домен машины A, порт 443. Имя в серте ядра — SYLPH_CORE_NAME
SYLPH_CORE_URL=https://203.0.113.10:443
SYLPH_CORE_NAME=core.sylph.internal

# Сколько живёт сессия после входа, часов (1–168)
SYLPH_PANEL_SESSION_HOURS=12

# Сеть compose и адрес Caddy в ней: панель верит X-Forwarded-For только от этого адреса.
# Менять, только если подсеть пересекается с сетями машины (адрес Caddy — внутри подсети).
SYLPH_SUBNET=172.30.10.0/24
SYLPH_CADDY_IP=172.30.10.10
SYLPH_HTTPS_PORT=443
SYLPH_LOG_LEVEL=info
