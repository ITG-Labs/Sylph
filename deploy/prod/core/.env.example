# Версия образов Sylph (тег из GHCR, всегда конкретный: не edge)
SYLPH_VERSION=0.1.0

# Пароль Postgres: только буквы и цифры, он идёт в DSN ядра (openssl rand -hex 32)
POSTGRES_PASSWORD=

# ЮKassa: все три вместе или ни одного (тогда оплата выключена).
# Ключи — только здесь: ядро единственное ходит в ЮKassa.
SYLPH_YOOKASSA_SHOP_ID=
SYLPH_YOOKASSA_SECRET_KEY=
# Куда ЮKassa вернёт юзера после оплаты
SYLPH_YOOKASSA_RETURN_URL=https://t.me/your_bot

# Имя бота без @: ссылки-приглашения в приватные тарифы
SYLPH_BOT_USERNAME=your_bot

# Пояс суток статистики
SYLPH_STATS_TZ=Europe/Moscow

# Внешний порт ядра (mTLS); агенты и сервисы ходят сюда
SYLPH_HTTPS_PORT=443
SYLPH_LOG_LEVEL=info
