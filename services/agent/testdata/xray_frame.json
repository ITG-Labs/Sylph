{
  "log": {
    "loglevel": "warning",
    "access": "none"
  },
  "api": {
    "tag": "sylph_api",
    "listen": "127.0.0.1:10085",
    "services": [
      "HandlerService",
      "StatsService"
    ]
  },
  "stats": {},
  "policy": {
    "levels": {
      "0": {
        "statsUserUplink": true,
        "statsUserDownlink": true
      }
    }
  },
  "inbounds": [],
  "outbounds": [
    {
      "tag": "direct",
      "protocol": "freedom"
    }
  ]
}
