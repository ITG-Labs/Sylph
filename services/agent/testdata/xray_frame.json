{
  "log": {
    "loglevel": "warning",
    "access": "none"
  },
  "api": {
    "tag": "sylph_api",
    "listen": "127.0.0.1:10085",
    "services": [
      "HandlerService",
      "StatsService"
    ]
  },
  "stats": {},
  "policy": {
    "levels": {
      "0": {
        "statsUserUplink": true,
        "statsUserDownlink": true,
        "statsUserOnline": true
      }
    }
  },
  "inbounds": [],
  "outbounds": [
    {
      "tag": "direct",
      "protocol": "freedom"
    },
    {
      "protocol": "blackhole",
      "tag": "sylph_block"
    }
  ],
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      {
        "ip": [
          "0.0.0.0/8",
          "10.0.0.0/8",
          "100.64.0.0/10",
          "127.0.0.0/8",
          "169.254.0.0/16",
          "172.16.0.0/12",
          "192.0.0.0/24",
          "192.168.0.0/16",
          "198.18.0.0/15",
          "224.0.0.0/3",
          "::/127",
          "::1/128",
          "fc00::/7",
          "fe80::/10",
          "ff00::/8",
          "64:ff9b::/96",
          "64:ff9b:1::/48"
        ],
        "outboundTag": "sylph_block",
        "ruleTag": "sylph-guard"
      },
      {
        "domain": [
          "full:localhost",
          "domain:localhost",
          "domain:local",
          "domain:internal",
          "domain:lan",
          "domain:home.arpa",
          "domain:localdomain"
        ],
        "outboundTag": "sylph_block",
        "ruleTag": "sylph-guard-names"
      }
    ]
  }
}
